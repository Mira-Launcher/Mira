# Maintainer: arigood99 <arigood99@gmail.com>
pkgname=mira-launcher
pkgver=0.12.0
pkgrel=1
pkgdesc="Linux game launcher for native games and Windows games via Wine/Proton"
arch=('x86_64')
url="https://github.com/Mira-Launcher/Mira"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'curl' 'qt6-base')
makedepends=('cmake' 'ninja' 'clang')
optdepends=('wine: run Windows games without Proton'
           'umu-launcher: Proton support (AUR)'
           'winetricks: install DLL/redistributable fixes into a game prefix'
           '7zip: auto-extract archives dropped into a library root')
backup=()
source=("mira-$pkgver.tar.gz::https://github.com/Mira-Launcher/Mira/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3170c5b408760a1c43f9310eb738fab6644b5b2a6cc98d538636677a878e38a5')

build() {
  # GitHub's archive directory name varies by endpoint (Mira-<version> vs.
  # Mira-Launcher-Mira-<commit sha>, confirmed by testing both) -- there's exactly
  # one directory extracted here regardless of what it's named.
  cd "$srcdir"/*/
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -GNinja
  cmake --build build
}

package() {
  cd "$srcdir"/*/
  DESTDIR="$pkgdir" cmake --install build
}
