# Maintainer: arigood99 <arigood99@gmail.com>
pkgname=mira-launcher
pkgver=0.13.3
pkgrel=1
pkgdesc="Linux game launcher for native games and Windows games via Wine/Proton"
arch=('x86_64')
url="https://github.com/Mira-Launcher/Mira"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'curl' 'qt6-base' 'qt6-multimedia' '7zip')
makedepends=('cmake' 'ninja')
optdepends=('wine: run Windows games without Proton'
           'umu-launcher: Proton support (AUR)'
           'winetricks: install DLL/redistributable fixes into a game prefix'
           'cabextract: needed by winetricks'
           'unzip: needed by winetricks'
           'gamemode: GameMode while a game runs'
           'mangohud: performance overlay'
           'sdl3: controllers and sounds in big screen'
           'polkit: install missing system packages from Mira'
           'sqlite: import Lutris libraries')
backup=()
source=("mira-$pkgver.tar.gz::https://github.com/Mira-Launcher/Mira/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  # GitHub's archive directory name varies by endpoint (Mira-<version> vs.
  # Mira-Launcher-Mira-<commit sha>, confirmed by testing both) -- there's exactly
  # one directory extracted here regardless of what it's named.
  cd "$srcdir"/*/
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -GNinja
  cmake --build build
}

package() {
  cd "$srcdir"/*/
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
