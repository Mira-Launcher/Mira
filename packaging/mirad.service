[Unit]
Description=Mira game launcher backend
Documentation=https://github.com/Mira-Launcher/Mira
# Not required by default: the frontend can spawn and supervise mirad itself
# (see docs/architecture.md) for anyone who would rather not run a persistent
# background process. Enabling this unit is the other supported path.
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/mirad
Restart=on-failure
RestartSec=2
# Games run as mirad's children; stopping or updating mirad leaves them running.
KillMode=process

[Install]
WantedBy=default.target
