/* Mira's stylesheet. Not a theme: themes are the .toml token files, and
 * every @name below is substituted from the one being applied (ui/Theme.cpp).
 *
 * Broad backgrounds are left to the palette, which Fusion already honours;
 * what is here is the chrome the palette cannot express: shape, spacing,
 * borders and the states (hover, focus, checked) that make the app feel less
 * like a stock Qt dialog. */

/* --- Text roles ---------------------------------------------------------- */

QLabel[role="muted"] {
  color: @text_muted;
  font-size: @font_size_small;
}

QLabel[role="heading"] {
  font-size: @font_size_heading;
  font-weight: 600;
}

/* Muted color at the label's own size, for text inside a control. */
QLabel[role="subtle"] {
  color: @text_muted;
}

QLabel[role="section"] {
  font-weight: 600;
}

/* A small heading over a group of rows ("PINNED", "SORT"). */
QLabel[role="group_heading"] {
  color: @text_muted;
  font-size: @font_size_small;
  font-weight: 600;
  letter-spacing: 0.04em;
}

QWidget#divider {
  background: @border;
}

/* A tile's place while a store is asked for its games the first time. */
QWidget#tile_skeleton {
  background: @surface;
  border-radius: 6px;
}

/* Where a dragged source row would land in the sidebar. */
QWidget#drop_line {
  background: @accent;
}

QLabel[role="error"] {
  color: @error;
  font-size: @font_size_small;
}

QLabel[role="keys"] {
  font-family: monospace;
  font-weight: 600;
}

/* A game's lifecycle state, set as a "status" property so a theme change
 * recolors it without the widget having to be repopulated (ui/Theme.h's
 * SetStyleProperty). "running" is not a status mirad reports; it is the
 * frontend's own "playing right now". */
QLabel[status="ready"],
QLabel[status="setting_up"],
QLabel[status="broken"],
QLabel[status="missing"],
QLabel[status="needs_install"] {
  font-size: @font_size_small;
  font-weight: 600;
}

QLabel[status="ready"] { color: @status_ready; }
QLabel[status="setting_up"] { color: @status_setting_up; }
QLabel[status="broken"] { color: @status_broken; }
QLabel[status="missing"] { color: @status_missing; }
QLabel[status="needs_install"] { color: @status_needs_install; }
QLabel[status="running"] {
  font-size: @font_size_small;
  font-weight: 600;
  color: @running;
}

/* --- The custom top bar -------------------------------------------------- */

QWidget#top_bar {
  background: @surface;
  border-bottom: 1px solid @border;
}

QWidget#top_bar QToolButton {
  border: none;
  border-radius: @radius_control;
  padding: 5px;
}

/* The button already opens a menu on click; Qt's little corner triangle just
 * adds noise next to a glyph this small. */
QWidget#top_bar QToolButton::menu-indicator {
  image: none;
  width: 0;
}

QWidget#top_bar QToolButton:hover {
  background: @surface_alt;
}

QWidget#top_bar QToolButton:pressed {
  background: @border;
}

QWidget#top_bar QToolButton#close_button:hover {
  background: @error;
}

/* --- Filter/sort pill, its popover, and the sidebar's icon-button tools -- */

QWidget#filter_sort_button {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
}

QWidget#filter_sort_button:hover {
  border-color: @accent;
}

QWidget#filter_sort_popover {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QWidget#downloads_popover {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QWidget#downloads_popover QScrollArea,
QWidget#downloads_popover QScrollArea > QWidget > QWidget {
  background: transparent;
}

QFrame#download_row {
  border-top: 1px solid @border;
}

QFrame#download_row[first="true"] {
  border-top: none;
}

QWidget#filter_sort_popover QToolButton {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 5px 4px;
}

QWidget#filter_sort_popover QToolButton:hover {
  background: @surface_alt;
}

/* The sort rows -- same flat, full-width, icon-optional treatment as the
 * left sidebar's own nav rows (QWidget#left_sidebar QPushButton), just
 * scoped to the popover instead since these live outside the sidebar. */
QWidget#filter_sort_popover QPushButton {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 7px 10px;
  text-align: left;
}

QWidget#filter_sort_popover QPushButton:hover {
  background: @surface_alt;
}

QWidget#filter_sort_popover QToolButton:checked,
QWidget#filter_sort_popover QPushButton:checked {
  background: @accent;
  color: @on_accent;
}

QWidget#left_sidebar QToolButton#add_games {
  background: @accent;
  color: @on_accent;
  border: 1px solid @accent;
  border-radius: @radius_control;
  padding: 7px 10px;
  font-weight: 600;
}

QWidget#left_sidebar QToolButton#add_games:hover {
  background: @info;
  border-color: @info;
}

QWidget#left_sidebar QToolButton#add_games::menu-indicator {
  image: none;
  width: 0px;
}

QWidget#left_sidebar QToolButton#fetch_art {
  background: transparent;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 6px;
}

QWidget#left_sidebar QToolButton#fetch_art:hover {
  border-color: @accent;
  background: @surface_alt;
}

QLabel#brand_badge {
  background: @accent;
  color: @on_accent;
  border-radius: 6px;
  font-weight: 700;
}

QLabel#brand_title {
  font-weight: 700;
  font-size: 15px;
}

/* --- Left sidebar ---------------------------------------------------------
 * The nav, source and recently played rows are plain QPushButtons made to read as rows
 * (see ui/GameTileDelegate.cpp's own status-dot styling for the same
 * "flatten it, then restyle by objectName" approach elsewhere). */

/* The sidebar paints no background of its own: it shows the window's color, and
 * the splitter's handle is its divider. */

/* The pinned/sources/recent list scrolls; it shows the sidebar's own surface. */
QWidget#left_sidebar QScrollArea,
QWidget#left_sidebar QScrollArea > QWidget > QWidget {
  background: transparent;
}

QWidget#left_sidebar QPushButton {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 7px 10px;
  text-align: left;
}

/* The pinned/sources/recent rows scroll; their area takes the sidebar's own
 * background instead of drawing a darker box. */
QWidget#left_sidebar QScrollArea,
QWidget#left_sidebar QScrollArea > QWidget > QWidget {
  background: transparent;
}


QWidget#left_sidebar QPushButton:hover {
  background: @surface_alt;
}

QWidget#left_sidebar QPushButton:pressed {
  background: @border;
}

QWidget#left_sidebar QPushButton:checked {
  background: @accent;
  color: @on_accent;
}

/* setItemWidget rows (LibraryWindow.cpp's MakeFilterRow) draw their own
 * selected-state text color by hand -- this only covers the row's
 * background and shape. */
QListWidget#filter_list {
  background: transparent;
  border: none;
}

QListWidget#filter_list::item {
  padding: 0px;
  border-radius: @radius_control;
}

QListWidget#filter_list::item:selected {
  background: @accent;
}

/* --- Buttons ------------------------------------------------------------- */

QPushButton {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 5px 14px;
}

QPushButton:hover {
  border-color: @accent;
}

QPushButton:pressed {
  background: @border;
}

QPushButton:default {
  background: @accent;
  border-color: @accent;
  color: @on_accent;
}

QPushButton:disabled {
  color: @text_muted;
  border-color: @border;
}

QPushButton:default:disabled {
  background: @surface_alt;
}

/* Frameless tool buttons (autoRaise): back, close, fold, more, a row's grip
 * and undo. Fusion's own hover is a raised bevel that matches nothing else. */
QToolButton[autoRaise="true"] {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 4px;
}

QToolButton[autoRaise="true"]:hover {
  background: @surface_alt;
}

QToolButton[autoRaise="true"]:pressed {
  background: @border;
}

QToolButton[autoRaise="true"]:checked {
  background: @accent_soft;
}

QToolButton[autoRaise="true"]:focus {
  border: 1px solid @accent;
  padding: 3px;
}

/* A menu button's glyph already says it opens a menu. */
QToolButton[autoRaise="true"]::menu-indicator {
  image: none;
  width: 0;
}

/* A card's "Reset to defaults", quieter than the settings around it. */
QToolButton#card_reset {
  color: @text_muted;
  padding: 0 8px;
}

QToolButton#card_reset:hover {
  color: @text;
}

QToolButton#card_reset:focus {
  padding: 0 7px;
}

/* --- Inputs -------------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px 8px;
  selection-background-color: @accent;
  selection-color: @on_accent;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: @accent;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
  color: @text_muted;
}

/* Styling a combo's frame means owning its arrow and its popup too, or the
 * stock ones stay behind and stop matching. */
QComboBox::drop-down {
  border: none;
  width: 18px;
}

QComboBox::down-arrow {
  image: @chevron_glyph;
  width: 12px;
  height: 12px;
  margin-right: 6px;
}

/* Styling a spinbox's frame hides Fusion's own up/down buttons unless the
 * subcontrols are given explicitly here too. */
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 18px;
  border-left: 1px solid @border;
  border-top-right-radius: @radius_control;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 18px;
  border-left: 1px solid @border;
  border-bottom-right-radius: @radius_control;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: @chevron_up_glyph;
  width: 10px;
  height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: @chevron_glyph;
  width: 10px;
  height: 10px;
}

QComboBox QAbstractItemView {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px;
  outline: none;
  selection-background-color: @accent;
  selection-color: @on_accent;
}

QCheckBox::indicator, QRadioButton::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid @border;
  border-radius: 3px;
  background: @surface;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: @accent;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  background: @accent;
  border-color: @accent;
  image: @check_glyph;
}

/* --- Tabs ---------------------------------------------------------------- */

QTabWidget::pane {
  border: none;
  border-top: 1px solid @border;
  top: -1px;
}

QTabBar::tab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 7px 14px;
  margin: 0;
  color: @text_muted;
}

QTabBar::tab:hover {
  color: @text;
}

QTabBar::tab:selected {
  color: @text;
  border-bottom-color: @accent;
}

/* --- Sliders ------------------------------------------------------------- */

QSlider::groove:horizontal {
  height: 4px;
  background: @border;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background: @accent;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: @text;
  width: 12px;
  height: 12px;
  margin: -5px 0;
  border-radius: 6px;
}

QSlider::handle:horizontal:disabled {
  background: @text_muted;
}

/* --- Scrollbars ---------------------------------------------------------- */

QScrollBar:vertical, QScrollBar:horizontal {
  background: transparent;
  border: none;
  margin: 0;
}

QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: @border;
  border-radius: 5px;
  min-height: 32px;
  min-width: 32px;
}

QScrollBar::handle:hover {
  background: @text_muted;
}

QScrollBar::add-line, QScrollBar::sub-line {
  width: 0;
  height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}

/* --- Lists, tables, menus ------------------------------------------------ */

/* The grid paints its own tiles (ui/GameTileDelegate), so it wants a backdrop
 * and nothing else: a stylesheet selection here would draw underneath them. */
QListWidget#library_grid {
  background: @window;
  border: none;
}

/* --- Settings (ui/SettingsNav, ui/SettingsCard) --------------------------
 * The nav is the main sidebar's twin: the window's color, as the sidebar shows,
 * and the same flat rows, under small uppercase group headings. */

QWidget#settings_nav {
  background: @window;
  border-right: 1px solid @border;
}

QWidget#settings_nav QScrollArea,
QWidget#settings_nav QScrollArea > QWidget > QWidget {
  background: transparent;
}

QWidget#settings_nav QPushButton {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 7px 10px;
  text-align: left;
}

QWidget#settings_nav QPushButton:hover {
  background: @surface_alt;
}

QWidget#settings_nav QPushButton:checked {
  background: @accent;
  color: @on_accent;
}

QLabel[role="nav_heading"] {
  color: @text_muted;
  font-size: @font_size_small;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 12px 4px 3px 4px;
}

QWidget#settings_nav QPushButton:disabled {
  color: @text_muted;
}

QScrollArea#settings_page,
QWidget#settings_canvas {
  background: @window;
}

/* The group heading above the first page of each group, flush with the titles. */
QWidget#settings_section QLabel[role="nav_heading"] {
  padding: 0;
}

/* The current page's title, held at the top of the scroll; top padding matches
 * kTitleClearance in ui/SettingsNav.cpp. */
QLabel#settings_sticky {
  background: @window;
  border-bottom: 1px solid @border;
  padding: 14px 32px 12px 32px;
}

QFrame#settings_card {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

/* A card whose rows scroll inside it shows the card's surface behind them. */
QScrollArea#card_scroll,
QScrollArea#card_scroll > QWidget > QWidget {
  background: transparent;
}

/* Fields sit a step darker than the card they are on, as in the grid. */
QFrame#settings_card QLineEdit,
QFrame#settings_card QSpinBox,
QFrame#settings_card QDoubleSpinBox,
QFrame#settings_card QComboBox {
  background: @window;
}

/* An unsaved change. */
QWidget#row_dot {
  background: @accent;
  border-radius: 3px;
}

QWidget#setting_row[dragging="true"] {
  background: @surface_alt;
}

QFrame#change_bar {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

/* A source's Store, Launcher or Local tag beside its name. */
QLabel#kind_tag {
  color: @text_muted;
  font-size: @font_size_small;
  border: 1px solid @border;
  border-radius: 8px;
  padding: 0px 6px;
}

/* The game card's "Not checked" beside Executable, when mirad wasn't sure of its pick. */
QLabel#check_tag {
  color: @warning;
  font-size: @font_size_small;
  border: 1px solid @warning;
  border-radius: 8px;
  padding: 0px 6px;
}

/* ui/ListEdit: a list setting as rows in one box. */
QWidget#list_edit {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
}

QFrame#settings_card QLineEdit#list_item {
  background: transparent;
  border: none;
  padding: 6px 0px;
}

QPushButton#list_add,
QPushButton#text_button {
  background: transparent;
  border: none;
  color: @accent;
  padding: 6px 10px;
  text-align: left;
}

QPushButton#list_add:hover,
QPushButton#text_button:hover {
  text-decoration: underline;
}

QPushButton#text_button:disabled {
  color: @text_muted;
  text-decoration: none;
}

/* ui/TagEdit: one chip per tag. */
QFrame#tag_chip {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
}

QFrame#tag_chip[folder="true"] {
  border: 1px solid @accent;
}

QToolButton#tag_remove {
  border: none;
  border-radius: @radius_control;
  padding: 1px;
}

QToolButton#tag_remove:hover {
  background: @border;
}

QListWidget, QTreeWidget, QTableWidget {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
  outline: none;
}

QListWidget::item, QTreeWidget::item, QTableWidget::item {
  padding: 4px;
  border-radius: @radius_control;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
  background: @accent;
  color: @on_accent;
}

QHeaderView::section {
  background: @surface_alt;
  border: none;
  border-bottom: 1px solid @border;
  padding: 6px 8px;
  font-weight: 600;
}

QMenu {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
  padding: 5px;
}

QMenu::item {
  padding: 6px 22px 6px 12px;
  border-radius: @radius_control;
}

QMenu::item:selected {
  background: @accent;
  color: @on_accent;
}

QMenu::item:disabled {
  color: @text_muted;
}

QMenu::separator {
  height: 1px;
  background: @border;
  margin: 5px 8px;
}

QToolTip {
  background: @surface_alt;
  color: @text;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px 7px;
}

/* --- Containers ---------------------------------------------------------- */

QSplitter::handle {
  background: @border;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QGroupBox {
  border: 1px solid @border;
  border-radius: @radius_panel;
  margin-top: 10px;
  padding-top: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
}

QScrollArea {
  border: none;
}

/* --- Game-edit overlay ---------------------------------------------------
 * The scrim and the card (ui/HeroBackdrop) are painted in code; these are
 * what sits over the card's hero art. */

QLabel#game_edit_title, QLabel#page_title {
  font-size: 22px;
  font-weight: 700;
}

/* Dark glass whatever the theme: they sit on the art, not the surface. */
QPushButton#hero_action {
  background: rgba(20, 22, 27, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: #e6e8ec;
  border-radius: 8px;
  padding: 5px 12px;
}

QPushButton#hero_action:hover {
  background: rgba(20, 22, 27, 0.8);
}

QPushButton#hero_action:checked {
  background: @accent_soft;
  border-color: @accent;
}

/* --- Page header and tabs (ui/PageHeader) -------------------------------- */

QLabel#page_status {
  color: @text_muted;
}

QWidget#tab_row {
  border-bottom: 1px solid @border;
}

QWidget#tab_row QPushButton,
QWidget#picker_tabs QPushButton {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  color: @text_muted;
  padding: 8px 12px;
}

QWidget#tab_row QPushButton:hover,
QWidget#picker_tabs QPushButton:hover {
  color: @text;
}

QWidget#tab_row QPushButton:checked,
QWidget#picker_tabs QPushButton:checked {
  color: @text;
  font-weight: 600;
  border-bottom-color: @accent;
}

/* --- Continue playing (ui/ContinueRow) ----------------------------------- */

QFrame#continue_card {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QFrame#continue_card:hover {
  border-color: @accent;
}

/* --- Source setup steps (views/SourcePage) ------------------------------- */

QLabel#step_title[state="todo"] {
  color: @text_muted;
}

QLabel#step_marker {
  border: 1px solid @border;
  border-radius: 11px;
  color: @text_muted;
  font-weight: 600;
}

QLabel#step_marker[state="current"] {
  background: @accent;
  border-color: @accent;
  color: @on_accent;
}

QLabel#step_marker[state="done"] {
  border-color: @success;
  color: @success;
}

/* --- Art picker ---------------------------------------------------------- */

QWidget#picker_bar {
  border-bottom: 1px solid @border;
}

QPushButton#chip {
  background: transparent;
  border: 1px solid @border;
  border-radius: 10px;
  padding: 3px 10px;
  font-size: @font_size_small;
}

QPushButton#chip:hover {
  border-color: @text_muted;
}

/* Room for DropdownButton's chevron. */
QPushButton[dropdown="true"],
QPushButton#chip[dropdown="true"],
QWidget#tab_row QPushButton[dropdown="true"] {
  padding-right: 28px;
}

QPushButton#chip:checked {
  border-color: @accent;
  background: @accent_soft;
}

/* --- Runners page -------------------------------------------------------- */

/* The build Windows games use by default, beside its name. */
QLabel#default_tag {
  color: @accent;
  font-size: @font_size_small;
  border: 1px solid @accent;
  border-radius: 8px;
  padding: 0px 6px;
}

QWidget#segmented {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QWidget#segmented QPushButton {
  background: transparent;
  border: none;
  padding: 5px 18px;
}

QWidget#segmented QPushButton:checked {
  background: @accent;
  color: @on_accent;
  font-weight: 600;
}

/* A pick among a few: a store tile, a drive, a plan. Checked is outlined and washed in the accent. */
QPushButton#choice_card {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 8px 14px;
  text-align: left;
}

QPushButton#choice_card:hover {
  border-color: @accent;
}

QPushButton#choice_card:checked {
  background: @accent_soft;
  border: 1px solid @accent;
}

QPushButton#choice_card:focus:!checked {
  border: 1px dashed @accent;
}

QPushButton#choice_card:disabled {
  color: @text_muted;
}

/* --- Set up Mira (setup/SetupWindow) ------------------------------------------- */

QWidget#setup_window,
QScrollArea#setup_scroll,
QScrollArea#setup_scroll > QWidget > QWidget {
  background: @window;
}

QWidget#setup_foot {
  background: @surface;
  border-top: 1px solid @border;
}

QWidget#setup_foot QPushButton#text_button {
  color: @text_muted;
}

QWidget#setup_window QWidget#segmented QPushButton {
  padding: 4px 11px;
}

QLabel#setup_running {
  background: @surface;
  border: 1px solid @border;
  border-radius: 8px;  /* Qt draws square corners past half the height */
  padding: 2px 9px;
  font-size: @font_size_small;
  color: @text_muted;
}

QLabel#setup_badge {
  background: @accent_faint;
  border-radius: 12px;
}

QLabel#setup_title {
  font-size: 21px;
  font-weight: 600;
}

QLabel#setup_strong,
QLabel#setup_tile_title {
  font-weight: 600;
}

QLabel#setup_tile_title {
  font-size: 15px;
}

QFrame#setup_card,
QFrame#setup_feature {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QFrame#setup_note {
  background: @info_faint;
  border: 1px solid @info;
  border-radius: @radius_panel;
}

QLabel#setup_path {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 5px 10px;
  font-family: monospace;
}

/* Clear, so a picked card's wash covers it too. */
QFrame#setup_art {
  background: transparent;
}

QLabel#setup_tick {
  border: 1.5px solid @text_muted;
  border-radius: 4px;
  color: @on_accent;
  font-size: 11px;
  font-weight: 700;
}

QLabel#setup_tick[on="true"] {
  background: @accent;
  border-color: @accent;
}

QLabel#setup_chip {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: 8px;
  padding: 2px 9px;
  font-size: @font_size_small;
}

QLabel#setup_chip[state="ok"] {
  color: @success;
  border-color: @success;
}

QLabel#setup_chip[state="warning"] {
  color: @warning;
  border-color: @warning;
}

QLabel#setup_chip[state="error"] {
  color: @error;
  border-color: @error;
}

QPushButton#setup_account {
  background: transparent;
  border: 1.5px solid @border;
  border-radius: @radius_control;
  text-align: left;
}

QPushButton#setup_account:checked {
  border-color: @accent;
}

QLabel#setup_radio {
  border: 1.5px solid @text_muted;
  border-radius: 8px;
}

QLabel#setup_radio[on="true"] {
  border: 5px solid @accent;
}

QLabel#setup_avatar {
  border-radius: 14px;
  color: white;
  font-weight: 600;
}

QLabel#setup_mark {
  background: @surface_alt;
  border-radius: 9px;
  color: @text_muted;
  font-weight: 700;
}

QLabel#setup_doc {
  border-radius: 5px;
  color: white;
  font-weight: 700;
  font-size: 14px;
}

QLabel#setup_check {
  background: @success_faint;
  border-radius: 32px;
}

QLabel#setup_done_title {
  font-size: 24px;
  font-weight: 600;
}

QLabel#setup_signed_in {
  color: @success;
  font-weight: 600;
}

QFrame#setup_star {
  background: rgba(227, 179, 65, 0.12);
  border: 1px solid rgba(227, 179, 65, 0.5);
  border-radius: @radius_panel;
}

QLabel#setup_star_glyph {
  color: #e3b341;
  font-size: 26px;
}

QLabel#setup_link {
  font-weight: 600;
}


QPlainTextEdit#log_view {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 6px 8px;
}
