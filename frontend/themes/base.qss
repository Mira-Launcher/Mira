/* Mira's stylesheet. Not a theme: themes are the .toml token files, and
 * every @name below is substituted from the one being applied (theme/Theme.cpp).
 *
 * Broad backgrounds are left to the palette, which Fusion already honours;
 * what is here is the chrome the palette cannot express: shape, spacing,
 * borders and the states (hover, focus, checked) that make the app feel less
 * like a stock Qt dialog. */

/* --- Text roles ---------------------------------------------------------- */

/* components/Text: a label's role, size and tone, set apart so they combine. */
QLabel[text_role="section"] {
  font-weight: 600;
}

QLabel[text_role="heading"] {
  font-size: @font_size_heading;
  font-weight: 600;
}

/* A small heading over a group of rows ("PINNED", "SORT"). */
QLabel[text_role="group"] {
  font-weight: 600;
  letter-spacing: 0.04em;
}

QLabel[text_size="small"] {
  font-size: @font_size_small;
}

QLabel[tone="muted"] { color: @text_muted; }
QLabel[tone="accent"] { color: @accent; }
QLabel[tone="info"] { color: @info; }
QLabel[tone="success"] { color: @success; }
QLabel[tone="warning"] { color: @warning; }
QLabel[tone="danger"] { color: @error; }

/* What went wrong, over a setup card's rows. */
QLabel#problem_box {
  background: rgba(229, 72, 77, 31);
  color: @error;
  border-radius: @radius_control;
  padding: 8px 12px;
}

/* A glyph on a tile, before a card row's label (Add games' choices). */
QLabel#tile_icon {
  background: @surface_alt;
  border-radius: 7px;
}

QWidget#divider {
  background: @border;
}

/* A tile's place while a store is asked for its games the first time. */
QWidget#tile_skeleton {
  background: @surface;
  border-radius: @radius_tile;
}

/* Where a dragged source row would land in the sidebar. */
QWidget#drop_line {
  background: @accent;
}

/* One key of a shortcut, drawn as a keycap. */
QLabel#keycap {
  font-family: monospace;
  font-size: @font_size_small;
  background: @surface_alt;
  border: 1px solid @border;
  border-bottom-width: 2px;
  border-radius: 5px;
  padding: 0px 6px;
}

/* --- The custom top bar -------------------------------------------------- */

QWidget#top_bar {
  background: @top_bar;
  border-bottom: 1px solid @top_bar_border;
}

QLabel#hidden_note {
  color: @hidden_note;
}

QWidget#top_bar QToolButton {
  border: none;
  border-radius: @radius_control;
  padding: 5px;
}

/* The button already opens a menu on click; Qt's little corner triangle just
 * adds noise next to a glyph this small. */
QWidget#top_bar QToolButton::menu-indicator {
  image: none;
  width: 0;
}

QWidget#top_bar QToolButton:hover {
  background: @surface_alt;
}

QWidget#top_bar QToolButton:pressed {
  background: @border;
}

QWidget#top_bar QToolButton#close_button:hover {
  background: @error;
}

/* The one notice: a password wanted, a failed download, a new Mira. Quiet while Mira updates. */
QWidget#top_bar QToolButton#top_notice[busy="false"] {
  background: @accent;
  color: @on_accent;
  padding: 4px 12px;
  font-weight: 600;
}

QWidget#top_bar QToolButton#top_notice[busy="false"]:hover {
  background: @info;
}

QWidget#top_bar QToolButton#top_notice[busy="true"] {
  color: @text_muted;
  padding: 5px 8px;
}

/* --- Filter/sort pill, its popover, and the sidebar's icon-button tools -- */

QWidget#filter_sort_button {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
}

QWidget#filter_sort_button:hover {
  border-color: @accent;
}

/* components/Popover: a panel dropping down from a button. */
mira_gui--Popover {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

mira_gui--Popover QScrollArea,
mira_gui--Popover QScrollArea > QWidget > QWidget {
  background: transparent;
}

mira_gui--ListRow {
  border-top: 1px solid @border;
}

mira_gui--ListRow[first="true"] {
  border-top: none;
}

QWidget#filter_sort_popover QToolButton {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 5px 4px;
}

QWidget#filter_sort_popover QToolButton:hover {
  background: @surface_alt;
}

QWidget#filter_sort_popover QToolButton:checked {
  background: @accent;
  color: @on_accent;
}

QWidget#left_sidebar QToolButton#add_games {
  background: @accent;
  color: @on_accent;
  border: 1px solid @accent;
  border-radius: @radius_control;
  padding: 7px 10px;
  font-weight: 600;
}

QWidget#left_sidebar QToolButton#add_games:hover {
  background: @info;
  border-color: @info;
}

QWidget#left_sidebar QToolButton#add_games::menu-indicator {
  image: none;
  width: 0px;
}

QWidget#left_sidebar QToolButton#sidebar_square {
  background: transparent;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 6px;
}

QWidget#left_sidebar QToolButton#sidebar_square:hover,
QWidget#left_sidebar QToolButton#sidebar_square:checked {
  border-color: @accent;
  background: @surface_alt;
}

QLabel#brand_badge {
  background: @accent;
  color: @on_accent;
  border-radius: 6px;
  font-weight: 700;
}

QLabel#brand_title {
  font-weight: 700;
  font-size: 16px;
}

/* --- Left sidebar ---------------------------------------------------------
 * The sidebar paints no background of its own: it shows the window's color, and
 * the splitter's handle is its divider. */

/* The pinned/sources/recent list scrolls; it shows the sidebar's own surface. */
QWidget#left_sidebar QScrollArea,
QWidget#left_sidebar QScrollArea > QWidget > QWidget {
  background: transparent;
}

/* setItemWidget rows (LibraryWindow.cpp's MakeFilterRow) draw their own
 * selected-state text color by hand -- this only covers the row's
 * background and shape. */
QListWidget#filter_list {
  background: transparent;
  border: none;
}

QListWidget#filter_list::item {
  padding: 0px;
  border-radius: @radius_control;
}

QListWidget#filter_list::item:selected {
  background: @accent;
}

/* --- Buttons ------------------------------------------------------------- */

QPushButton {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 5px 14px;
}

QPushButton:hover {
  border-color: @accent;
}

QPushButton:pressed {
  background: @border;
}

QPushButton:disabled {
  color: @text_muted;
  border-color: @border;
}

/* components/NavRow: the sidebar's and Settings' rows, alike. After the plain QPushButton's rules,
 * which match it as specifically and would otherwise win. */
mira_gui--NavRow {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 7px 10px;
  text-align: left;
}

mira_gui--NavRow:hover {
  background: @surface_alt;
}

mira_gui--NavRow:pressed {
  background: @border;
}

mira_gui--NavRow:checked {
  background: @accent;
  color: @on_accent;
}

mira_gui--NavRow:disabled {
  color: @text_muted;
}

/* The game panel's jump list: a quiet mark for the card in view, so Play stays the bright thing. */
QWidget#game_panel mira_gui--NavRow:checked {
  background: @surface_alt;
  color: @text;
  font-weight: 600;
}

/* components/Button's kinds; a plain QPushButton is the Secondary look above. */
mira_gui--Button[kind="primary"] {
  background: @accent;
  border-color: @accent;
  color: @on_accent;
}

mira_gui--Button[kind="primary"]:hover {
  background: @accent_hover;
  border-color: @accent_hover;
}

mira_gui--Button[kind="primary"]:pressed {
  background: @accent_pressed;
  border-color: @accent_pressed;
}

/* A running game's Stop, and an action that deletes files. */
mira_gui--Button[kind="danger"] {
  background: @error;
  border-color: @error;
  color: @on_accent;
}

mira_gui--Button[kind="danger"]:hover {
  background: @error_hover;
  border-color: @error_hover;
}

mira_gui--Button[kind="danger"]:pressed {
  background: @error_pressed;
  border-color: @error_pressed;
}

mira_gui--Button[kind="primary"]:disabled,
mira_gui--Button[kind="danger"]:disabled {
  background: @surface_alt;
  border-color: @border;
  color: @text_muted;
}

/* Quiet actions: Link in the accent, underlined on hover; Text muted, in the text color on hover. */
mira_gui--Button[kind="link"],
mira_gui--Button[kind="text"] {
  background: transparent;
  border: none;
  padding: 6px 10px;
  text-align: left;
}

mira_gui--Button[kind="link"] {
  color: @accent;
}

mira_gui--Button[kind="link"]:hover {
  text-decoration: underline;
}

mira_gui--Button[kind="link"]:pressed {
  color: @accent_pressed;
}

mira_gui--Button[kind="text"] {
  color: @text_muted;
}

mira_gui--Button[kind="text"]:hover {
  color: @text;
}

mira_gui--Button[kind="text"]:pressed {
  background: @surface_alt;
}

mira_gui--Button[kind="link"]:disabled,
mira_gui--Button[kind="text"]:disabled {
  color: @text_muted;
  text-decoration: none;
}

mira_gui--Button[kind="text"]:disabled {
  background: transparent;
}

/* Glass over a game's art: dark whatever the theme, since it sits on the art, not the surface. */
mira_gui--Button[kind="glass"] {
  background: rgba(20, 22, 27, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: #e6e8ec;
  border-radius: @radius_control;
  padding: 5px 12px;
}

mira_gui--Button[kind="glass"]:hover {
  background: rgba(20, 22, 27, 0.8);
}

mira_gui--Button[kind="glass"]:pressed {
  background: rgba(20, 22, 27, 0.9);
}

mira_gui--Button[kind="glass"]:checked {
  background: @accent_soft;
  border-color: @accent;
}

mira_gui--Button[kind="glass"]:disabled {
  color: rgba(230, 232, 236, 0.45);
  border-color: rgba(255, 255, 255, 0.1);
}

/* Frameless tool buttons (autoRaise): back, close, fold, more, a row's grip
 * and undo. Fusion's own hover is a raised bevel that matches nothing else. */
QToolButton[autoRaise="true"] {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 4px;
}

QToolButton[autoRaise="true"]:hover {
  background: @surface_alt;
}

QToolButton[autoRaise="true"]:pressed {
  background: @border;
}

QToolButton[autoRaise="true"]:checked {
  background: @accent_soft;
}

/* A menu button's glyph already says it opens a menu. */
QToolButton[autoRaise="true"]::menu-indicator {
  image: none;
  width: 0;
}

/* A card's "Reset to defaults", quieter than the settings around it. */
QToolButton#card_reset {
  color: @text_muted;
  padding: 0 8px;
}

QToolButton#card_reset:hover {
  color: @text;
}

/* --- Inputs -------------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px 8px;
  selection-background-color: @accent;
  selection-color: @on_accent;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: @accent;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
  color: @text_muted;
}

/* Styling a combo's frame means owning its arrow and its popup too, or the
 * stock ones stay behind and stop matching. */
QComboBox::drop-down {
  border: none;
  width: 18px;
}

QComboBox::down-arrow {
  image: @chevron_glyph;
  width: 12px;
  height: 12px;
  margin-right: 6px;
}

/* Styling a spinbox's frame hides Fusion's own up/down buttons unless the
 * subcontrols are given explicitly here too. */
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 18px;
  border-left: 1px solid @border;
  border-top-right-radius: @radius_control;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 18px;
  border-left: 1px solid @border;
  border-bottom-right-radius: @radius_control;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: @chevron_up_glyph;
  width: 10px;
  height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: @chevron_glyph;
  width: 10px;
  height: 10px;
}

QComboBox QAbstractItemView {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px;
  outline: none;
  selection-background-color: @accent;
  selection-color: @on_accent;
}

/* components/FlatCombo's popup draws plain items, so they're styled here as the others look. */
mira_gui--FlatCombo QAbstractItemView::item {
  padding: 4px 8px;
  border-radius: @radius_control;
}

mira_gui--FlatCombo QAbstractItemView::item:selected {
  background: @accent;
  color: @on_accent;
}

QCheckBox::indicator, QRadioButton::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid @border;
  border-radius: 3px;
  background: @surface;
}

QRadioButton::indicator {
  border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: @accent;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  background: @accent;
  border-color: @accent;
  image: @check_glyph;
}

/* --- Tabs ---------------------------------------------------------------- */

QTabWidget::pane {
  border: none;
  border-top: 1px solid @border;
  top: -1px;
}

QTabBar::tab {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 7px 14px;
  margin: 0;
  color: @text_muted;
}

QTabBar::tab:hover {
  color: @text;
}

QTabBar::tab:selected {
  color: @text;
  border-bottom-color: @accent;
}

/* --- Sliders ------------------------------------------------------------- */

QSlider::groove:horizontal {
  height: 4px;
  background: @border;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background: @accent;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: @text;
  width: 12px;
  height: 12px;
  margin: -5px 0;
  border-radius: 6px;
}

QSlider::handle:horizontal:disabled {
  background: @text_muted;
}

/* --- Scrollbars ---------------------------------------------------------- */

/* components/OverlayScrollBar draws every bar over its content. Qt's own keeps the position, 1 px
   and undrawn: at 0 px Qt leaves it out of the accessibility tree. */
QScrollBar { background: transparent; border: none; margin: 0; }
QScrollBar:vertical { width: 1px; }
QScrollBar:horizontal { height: 1px; }
QScrollBar::handle, QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

/* --- Lists, tables, menus ------------------------------------------------ */

/* The grid paints its own tiles (library/GameTileDelegate), so it wants a backdrop
 * and nothing else: a stylesheet selection here would draw underneath them. */
QListView#library_grid {
  background: @window;
  border: none;
}

/* --- Settings (settings/SettingsNav, components/Card) --------------------------
 * The nav is the main sidebar's twin: the window's color, as the sidebar shows,
 * and the same flat rows, under small uppercase group headings. */

QWidget#settings_nav {
  background: @window;
  border-right: 1px solid @border;
}

QWidget#settings_nav QScrollArea,
QWidget#settings_nav QScrollArea > QWidget > QWidget {
  background: transparent;
}

QScrollArea#settings_page,
QWidget#settings_canvas {
  background: @window;
}

/* The current page's group and title, held at the top of the scroll over the column
 * (settings/SettingsNav.cpp). */
QWidget#settings_sticky {
  background: @window;
  border-bottom: 1px solid @border;
}

QWidget#settings_sticky[pushed="true"] {
  border-bottom: 1px solid transparent;
}

/* A card, and an achievement on the same raised surface. */
mira_gui--Card,
mira_gui--AchievementTile {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_card;
}

/* A card over a game's art lets it show through (Card::SetOverArt, the theme's art_card_alpha). */
mira_gui--Card[over_art="true"] {
  background: @surface_over_art;
}

/* components/SettingRow's ExpanderRow: its rows, opened, on a sunken surface. */
QWidget#expander_body {
  background: @surface_sunken;
  border-top: 1px solid @border;
}

/* A sunken row that ends its card takes the card's bottom corners (Card::RoundBottomRow). */
QWidget#list_row[card_bottom="true"],
QPushButton#list_more[card_bottom="true"],
QWidget#expander_body[card_bottom="true"],
QWidget#expander_head[card_bottom="true"] {
  border-bottom-left-radius: @radius_card_inner;
  border-bottom-right-radius: @radius_card_inner;
}

QWidget#expander_head:hover {
  background: @surface_alt;
}

/* One height for every control in a card (32 px with padding and border), with the row
 * labels' minimum height in components/SettingRow.cpp, so every row is as tall as the next. */
mira_gui--Card QLineEdit,
mira_gui--Card QSpinBox,
mira_gui--Card QDoubleSpinBox,
mira_gui--Card QComboBox {
  min-height: 22px;
  max-height: 22px;
}

/* A longer choice in a card is its value and a chevron, boxed only on hover. Its chevron ends
 * where the switches and fields of the rows around it do (components/FlatCombo sizes from this). */
mira_gui--Card QComboBox:!editable {
  background: transparent;
  border: 1px solid transparent;
  padding-right: 0;
}

mira_gui--Card QComboBox:!editable::drop-down {
  width: 14px;
}

mira_gui--Card QComboBox:!editable::down-arrow {
  margin-right: 1px;
}

mira_gui--Card QComboBox:!editable:hover,
mira_gui--Card QComboBox:!editable:focus {
  background: @surface_alt;
}


/* Fields sit a step darker than the card they are on, as in the grid. */
mira_gui--Card QLineEdit,
mira_gui--Card QSpinBox,
mira_gui--Card QDoubleSpinBox,
mira_gui--Card QComboBox {
  background: @window;
}

/* A choice among fields, boxed as they are. */
mira_gui--Card QComboBox[boxed="true"]:!editable {
  background: @window;
  border: 1px solid @border;
  padding-right: 6px;
}

/* An unsaved change. */
QWidget#row_dot {
  background: @accent;
  border-radius: 3px;
}

QWidget#setting_row[dragging="true"] {
  background: @surface_alt;
}

QFrame#change_bar {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

/* An emulator's empty library, where its games are dropped. */
QFrame#drop_zone {
  border: 2px dashed @border;
  border-radius: @radius_panel;
  background: transparent;
}

/* components/CopyField: a command to copy. */
QLabel#copy_field {
  font-family: monospace;
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 6px;
}

/* components/ListEdit: a list setting's items as sunken rows under its row. */
QWidget#list_row {
  background: @surface_sunken;
  border-top: 1px solid @border;
}

mira_gui--Card QLineEdit#list_item {
  background: transparent;
  border: none;
  padding: 6px 0px;
}

/* SettingEditor::Embed: a script's ready-made steps as chips over its own commands, in one box. */
QFrame#script_box {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
}

QFrame#script_box QLineEdit#script_line {
  background: transparent;
  border: none;
  border-top: 1px solid @border;
  border-radius: 0px;
  padding: 6px 2px;
  font-family: monospace;
}

QWidget#list_row[inherited="true"] QLineEdit#list_item {
  color: @text_muted;
}

QPushButton#list_more {
  background: @surface_sunken;
  border: none;
  border-top: 1px solid @border;
  border-radius: 0;
  color: @accent;
  padding: 8px 34px;
  text-align: left;
}

QPushButton#list_more:hover {
  text-decoration: underline;
}

QListWidget, QTreeWidget, QTableWidget {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
  outline: none;
}

QListWidget::item, QTreeWidget::item, QTableWidget::item {
  padding: 4px;
  border-radius: @radius_control;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
  background: @accent;
  color: @on_accent;
}

QHeaderView::section {
  background: @surface_alt;
  border: none;
  border-bottom: 1px solid @border;
  padding: 6px 8px;
  font-weight: 600;
}

QMenu {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
  padding: 5px;
}

QMenu::item {
  padding: 6px 22px 6px 12px;
  border-radius: @radius_control;
}

QMenu::item:selected {
  background: @accent;
  color: @on_accent;
}

QMenu::item:disabled {
  color: @text_muted;
}

QMenu::separator {
  height: 1px;
  background: @border;
  margin: 5px 8px;
}

QToolTip {
  background: @surface_alt;
  color: @text;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 4px 7px;
}

/* --- Containers ---------------------------------------------------------- */

QSplitter::handle {
  background: @border;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QGroupBox {
  border: 1px solid @border;
  border-radius: @radius_panel;
  margin-top: 10px;
  padding-top: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
}

QScrollArea {
  border: none;
}

/* components/Scrolling's SeeThrough: the area shows what's behind it. */
QAbstractScrollArea[see_through="viewport"],
QAbstractScrollArea[see_through="viewport"] > QWidget,
QAbstractScrollArea[see_through="page"],
QAbstractScrollArea[see_through="page"] > QWidget,
QAbstractScrollArea[see_through="page"] > QWidget > QWidget {
  background: transparent;
  border: none;
}

QLabel#drop_overlay {
  background: @window_veil;
  color: @text;
}

/* --- Game-edit overlay ---------------------------------------------------
 * The scrim and the card (game/HeroBackdrop) are painted in code; these are
 * what sits over the card's hero art. */

QLabel#game_edit_title, QLabel#page_title {
  font-size: 23px;
  font-weight: 700;
}

/* The game panel's saves and achievements lines, which open their pages: flat rows that light up
 * on hover like a nav row. The saves line's text is in labels inside it. */
QPushButton#panel_line {
  background: transparent;
  border: none;
  border-radius: @radius_control;
  padding: 4px 8px;
  color: @text;
  text-align: left;
}

QPushButton#panel_line:hover,
QPushButton#panel_line:focus {
  background: @surface_alt;
}

QPushButton#panel_line QLabel {
  color: @text;
}

QPushButton#panel_line[attention="true"] QLabel {
  color: @warning;
}

/* --- Page header and tabs (components/PageHeader) -------------------------------- */

QLabel#page_status {
  color: @text_muted;
}

QWidget#tab_row {
  border-bottom: 1px solid @border;
}

QWidget#tab_row QPushButton,
QWidget#picker_tabs QPushButton {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  color: @text_muted;
  padding: 8px 12px;
}

QWidget#tab_row QPushButton:hover,
QWidget#picker_tabs QPushButton:hover {
  color: @text;
}

QWidget#tab_row QPushButton:checked,
QWidget#picker_tabs QPushButton:checked {
  color: @text;
  font-weight: 600;
  border-bottom-color: @accent;
}

/* --- Continue playing (library/ContinueRow) ----------------------------------- */

QFrame#continue_card {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QFrame#continue_card:hover {
  border-color: @accent;
}

/* --- Source setup steps (views/SourcePage) ------------------------------- */

QLabel#step_title[state="todo"] {
  color: @text_muted;
}

QLabel#step_marker {
  border: 1px solid @border;
  border-radius: 11px;
  color: @text_muted;
  font-weight: 600;
}

QLabel#step_marker[state="current"] {
  background: @accent;
  border-color: @accent;
  color: @on_accent;
}

QLabel#step_marker[state="done"] {
  border-color: @success;
  color: @success;
}

/* Room for DropdownButton's chevron. */
QPushButton[dropdown="true"],
QWidget#tab_row QPushButton[dropdown="true"] {
  padding-right: 28px;
}

/* --- Runners page -------------------------------------------------------- */

/* A two or three way choice (components/Segmented). */
QWidget#segmented {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QWidget#segmented QPushButton {
  background: transparent;
  border: none;
  padding: 5px 18px;
}

QWidget#segmented QPushButton:checked {
  background: @accent;
  color: @on_accent;
  font-weight: 600;
}

QWidget#segmented QPushButton:checked:disabled {
  background: @surface_alt;
  color: @text_muted;
}

/* A pick among a few: a store tile, a drive, a plan. Checked is outlined and washed in the accent. */
/* Sources' tiles (sources/SourceTile): a step darker than the card they're on. */
QFrame#source_tile {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QFrame#source_tile[clickable="true"]:hover {
  border-color: @accent;
}

QLabel#source_tile_name {
  font-weight: 600;
}

QPushButton#choice_card {
  background: @surface_alt;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 8px 14px;
  text-align: left;
}

QPushButton#choice_card:hover {
  border-color: @accent;
}

QPushButton#choice_card:checked {
  background: @accent_soft;
  border: 1px solid @accent;
}

QPushButton#choice_card:disabled {
  color: @text_muted;
}

/* --- Set up Mira (setup/SetupWindow) ------------------------------------------- */

QWidget#setup_window,
QScrollArea#setup_scroll,
QScrollArea#setup_scroll > QWidget > QWidget {
  background: @window;
}

QWidget#setup_foot {
  background: @surface;
  border-top: 1px solid @border;
}

QWidget#setup_window QWidget#segmented QPushButton {
  padding: 4px 11px;
}

QLabel#setup_running {
  background: @surface;
  border: 1px solid @border;
  border-radius: 8px;  /* Qt draws square corners past half the height */
  padding: 2px 9px;
  font-size: @font_size_small;
  color: @text_muted;
}

QLabel#setup_badge {
  background: @accent_faint;
  border-radius: 12px;
}

QLabel#setup_title {
  font-size: 22px;
  font-weight: 600;
}

QLabel#setup_strong,
QLabel#setup_tile_title {
  font-weight: 600;
}

QLabel#setup_tile_title {
  font-size: 16px;
}

QFrame#setup_card,
QFrame#setup_feature,
QFrame#sources_card {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius_panel;
}

QFrame#setup_note {
  background: @info_faint;
  border: 1px solid @info;
  border-radius: @radius_panel;
}

QLabel#setup_path {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 5px 10px;
  font-family: monospace;
}

/* Clear, so a picked card's wash covers it too. */
QFrame#setup_art {
  background: transparent;
}

QLabel#setup_tick {
  border: 1.5px solid @text_muted;
  border-radius: 4px;
  color: @on_accent;
  font-size: 11px;
  font-weight: 700;
}

QLabel#setup_tick[on="true"] {
  background: @accent;
  border-color: @accent;
}

QPushButton#setup_account {
  background: transparent;
  border: 1.5px solid @border;
  border-radius: @radius_control;
  text-align: left;
}

QPushButton#setup_account:checked {
  border-color: @accent;
}

QLabel#setup_radio {
  border: 1.5px solid @text_muted;
  border-radius: 8px;
}

QLabel#setup_radio[on="true"] {
  border: 5px solid @accent;
}

QLabel#setup_avatar {
  border-radius: 14px;
  color: white;
  font-weight: 600;
}

QLabel#setup_mark {
  background: @surface_alt;
  border-radius: 9px;
  color: @text_muted;
  font-weight: 700;
}

QLabel#setup_doc {
  border-radius: 5px;
  color: white;
  font-weight: 700;
  font-size: 15px;
}

QLabel#setup_check {
  background: @success_faint;
  border-radius: 32px;
}

QLabel#setup_done_title {
  font-size: 24px;
  font-weight: 600;
}

QLabel#setup_signed_in {
  color: @success;
  font-weight: 600;
}

QLabel#setup_done {
  color: @success;
}

QFrame#setup_star {
  background: rgba(227, 179, 65, 0.12);
  border: 1px solid rgba(227, 179, 65, 0.5);
  border-radius: @radius_panel;
}

QLabel#setup_star_glyph {
  color: #e3b341;
  font-size: 26px;
}

QLabel#setup_link {
  font-weight: 600;
}

/* game/GameDetailsCard */
QLabel#screenshot {
  background: @surface_alt;
  border-radius: @radius_control;
}

QLabel#screenshot_large {
  background: rgba(0, 0, 0, 0.85);
}


QPlainTextEdit#log_view {
  background: @window;
  border: 1px solid @border;
  border-radius: @radius_control;
  padding: 6px 8px;
}

/* dialogs/LogWindow: the task's name in the window's own bar. */
QLabel#log_title {
  font-weight: 600;
}

QWidget#log_frame {
  background: @window;
  border: 1px solid @border;
}
